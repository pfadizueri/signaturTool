{
  "app": {
    "name": "Pfadi Züri Signatur Generator",
    "version": "1.0.0",
    "defaultLanguage": "de",
    "supportedLanguages": ["de"]
  },
  "signature": {
    "organizationName": "Pfadi Züri - Kantonalverband der Zürcher Pfadis",
    "addressLine1": "Birmensdorferstrasse 50",
    "addressLine2": "8004 Zürich",
    "websiteUrl": "www.pfadi.zuerich",
    "logoPath": "img/RZ_Logo_Pfadizueri_blau.png",
    "logoHeight": "150px",
    "fontFamily": "arial",
    "fontSize": "12.5px"
  },
  "form": {
    "validation": {
      "required": ["gender", "firstname", "mail", "roleLine1"],
      "emailPattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
    }
  },
  "ui": {
    "showStepNumbers": true,
    "enableFormValidation": true
  }
}
